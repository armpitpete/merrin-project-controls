{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://merrinworld.uk/schemas/project-status-v1.json",
  "title": "Merrin Project Status v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "finish_line",
    "percentage_complete",
    "completion_likelihood",
    "next_bounded_action"
  ],
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1
    },
    "finish_line": {
      "type": "string",
      "minLength": 1
    },
    "percentage_complete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimate",
        "confidence",
        "evidence",
        "remaining_work"
      ],
      "properties": {
        "estimate": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "remaining_work": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "completion_likelihood": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment",
        "confidence",
        "reasons"
      ],
      "properties": {
        "assessment": {
          "enum": [
            "unlikely",
            "possible",
            "likely",
            "very_likely"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "next_bounded_action": {
      "type": "string",
      "minLength": 1
    }
  }
}
