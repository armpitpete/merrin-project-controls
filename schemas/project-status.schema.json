{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://merrinworld.uk/schemas/project-status-v2.json",
  "title": "Merrin Project Status v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "finish_line",
    "percentage_complete",
    "completion_likelihood",
    "lifecycle_status",
    "next_bounded_action"
  ],
  "properties": {
    "project": {"type": "string", "minLength": 1},
    "finish_line": {"type": "string", "minLength": 1},
    "percentage_complete": {
      "type": "object",
      "description": "Planning estimate only. It does not establish lifecycle completion.",
      "additionalProperties": false,
      "required": ["estimate", "confidence", "evidence", "remaining_work"],
      "properties": {
        "estimate": {"type": "number", "minimum": 0, "maximum": 100},
        "confidence": {"enum": ["low", "medium", "high"]},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "remaining_work": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []}
      }
    },
    "completion_likelihood": {
      "type": "object",
      "description": "Planning forecast only. It does not establish lifecycle completion.",
      "additionalProperties": false,
      "required": ["assessment", "confidence", "reasons"],
      "properties": {
        "assessment": {"enum": ["unlikely", "possible", "likely", "very_likely"]},
        "confidence": {"enum": ["low", "medium", "high"]},
        "reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "lifecycle_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimed", "verified", "authority", "stages", "limitations"],
      "properties": {
        "claimed": {
          "enum": ["designed", "implemented", "automated-checks-passed", "independently-reviewed", "merged", "deployed", "live-behaviour-verified", "human-acceptance-received", "complete"]
        },
        "verified": {
          "enum": ["designed", "implemented", "automated-checks-passed", "independently-reviewed", "merged", "deployed", "live-behaviour-verified", "human-acceptance-received", "complete", "insufficient", "failed"]
        },
        "authority": {"type": "string", "minLength": 1},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "stages": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/stage"}
        }
      }
    },
    "next_bounded_action": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "required", "result", "relationship", "evidence", "limitations"],
      "properties": {
        "stage": {"enum": ["designed", "implemented", "automated-checks", "independent-review", "merged", "deployed", "live-behaviour", "human-acceptance"]},
        "required": {"type": "boolean"},
        "required_environment": {"type": "string", "minLength": 1},
        "observed_environment": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "result": {"enum": ["PASS", "FAIL", "INSUFFICIENT", "NOT_APPLICABLE"]},
        "relationship": {"enum": ["direct", "proxy", "missing", "not-applicable"]},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "allOf": [
        {
          "if": {"properties": {"required": {"const": true}}},
          "then": {"required": ["required_environment"], "not": {"required": ["rationale"]}}
        },
        {
          "if": {"properties": {"required": {"const": false}}},
          "then": {
            "required": ["rationale"],
            "properties": {
              "result": {"const": "NOT_APPLICABLE"},
              "relationship": {"const": "not-applicable"},
              "evidence": {"maxItems": 0}
            },
            "not": {"anyOf": [{"required": ["required_environment"]}, {"required": ["observed_environment"]}]}
          }
        },
        {
          "if": {"properties": {"result": {"enum": ["PASS", "FAIL"]}}},
          "then": {
            "required": ["required_environment", "observed_environment"],
            "properties": {"relationship": {"const": "direct"}, "evidence": {"minItems": 1}}
          }
        },
        {
          "if": {"properties": {"result": {"const": "INSUFFICIENT"}}},
          "then": {"properties": {"relationship": {"enum": ["direct", "proxy", "missing"]}}}
        }
      ]
    }
  }
}
